# ── Sécurité Django ────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=remplace-par-une-vraie-cle-secrete-longue
DEBUG=False
ALLOWED_HOSTS=*

# ── Base de données — PostgreSQL Railway (DATABASE_URL injectée par Railway) ──
# Sans DATABASE_URL : SQLite locale (db.sqlite3)
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── Cloudflare R2 ──────────────────────────────────────────────────────────────
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_BUCKET_NAME=gbaki-documents
CF_R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CF_R2_PRESIGN_EXPIRY=3600
CF_R2_THUMBS_PREFIX=_thumbs

# ── Email Gmail ────────────────────────────────────────────────────────────────
EMAIL_HOST_USER=ton-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL=True
